# ---- Aspen 模型与运行文件(不入库,只留说明) ----
model/*
!model/README.md
model-full/*
!model-full/README.md

# Aspen 运行中间文件(在任何目录都可能出现,统一忽略)
_*.*
!*.py
*.apw
*.bkp
*.apwz
*.bkpz
*.ads
*.his
*.appdf
*.sum
*.jnl
*.def
*.for

# 探测输出与截图(运行时生成)
probe_out/
probe_report.*
data/probe_topology.txt
data/preview/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 本地工况库与运行日志
*.db
*.sqlite3
*.log
data/window.json

# 本地配置(工段边界按工况手填,含真实位号,不入库;样例见 samples/sections.example.json)
data/config/

# 公开样本库:唯一放行的 .db(见 samples/README.md)
!samples/*.db

# 标准规范 PDF(21 MB,只在本地查;规则已摘进 docs/pipe-class-codes.md)
standards/*
!standards/README.md
*.pdf

# 第三方安装包 / 选型工具(不入库,如水泵选型安装包)
*.exe

# ---- 内部文档(会话交接、内部笔记;本地保留,不公开) ----
docs/_internal/

# ---- SQLite 运行期附属文件:含完整数据页,必须忽略 ----
*-wal
*-shm
*-journal

# ---- 本地配置 / 编辑器 / 系统噪声 ----
.env
.env.*
*.bak
*.tmp
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 项目专属的禁词 / 放行规则(本地,不公开) ----
.public-safe.local
